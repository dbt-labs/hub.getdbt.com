<header class="header">
  <% if is_hidden(package, version) or (defined?(package.redirectnamespace) or defined?(package.redirectname)) %>
    <div class="row">
      <div class="col-md-12" style="padding:0px;">
        <%= partial "hidden" %>
      </div>
    </div>
  <% end %>
  <%= partial "nav" %>
  <section class="section white section-slim" style="padding-bottom:66px;">
  </section>
</header>

<main class="main">
  <section class="section white section-slim">
    <div class="section-content">

      <div class="package-header">
        
        <!-- Left column: Package info -->
        <div class="package-info">
          <div class="tile-body" style="box-shadow: none; overflow: visible">
            <div class="tile-graphic">
              <%= image_tag(package.assets.logo, {alt: package.name}) %>
            </div>
            <div class="tile-text">
              <div class="package-title-row">
                <h1><%= package.name %></h1>
              </div>
              <em>
                Created by
                <a href="<%= site_url %>/<%= package.namespace %>/"
                   target="_self">
                  <%= package.namespace %>
                </a>
              </em><br/>
              <div class="github-v2-row">
                <% if is_valid_github_url(version._source.url) %>
                <a class="github-button"
                   href="<%=version._source.url.split("/tree/")[0]%>"
                   data-size="large"
                   data-show-count="true"
                   aria-label="Star the package on GitHub"
                   target="_blank">
                  <i data-icon="star"></i>
                  <%= version._source.url.split("/")[3] %>/<%= version._source.url.split("/")[4] %>
                </a>
                <% end %>
                <%
                  # Determine badge state and popover text
                  v2_compat = v2_compat_data(version)
                  is_manually_verified_compatible = v2_compat && v2_compat.manually_verified_compatible == true
                  is_manually_verified_incompatible = v2_compat && v2_compat.manually_verified_incompatible == true
                  has_parse_conformance = v2_compat && !v2_compat.parse_compatible.nil?
                  is_based_on_require_only = !is_manually_verified_compatible && !is_manually_verified_incompatible && !has_parse_conformance
                  is_fully_compatible = is_v2_compatible(package, version)
                  is_parse_compat = is_v2_parse_compatible(package, version)
                %>
                <% if is_fully_compatible %>
                  <span class="v2-badge<% if is_manually_verified_compatible || is_based_on_require_only %> has-popover<% end %>"
                    <% if is_manually_verified_compatible || is_based_on_require_only %>tabindex="0"<% end %>>v2 compatible
                    <% if is_manually_verified_compatible %>
                      <span class="popover-text">dbt has manually verified that this package version is compatible with dbt v2</span>
                    <% elsif is_based_on_require_only %>
                      <span class="popover-text">Compatibility based on require-dbt-version. Parse compatibility has not yet been run on this version.</span>
                    <% end %>
                  </span>
                <% elsif is_parse_compat %>
                  <span class="v2-badge-parse-compat has-popover" tabindex="0">v2 parse compatible
                    <span class="popover-text">This version of the package has not been classified as v2-compatible by its maintainer or by manual verification from dbt Labs, but it has been automatically verified as compatible with dbt parse. Installing this package will not prevent dbt invocations from starting, but runtime behavior on dbt v2 may vary.</span>
                  </span>
                <% else %>
                  <span class="v2-badge-incompatible<% if is_manually_verified_incompatible %> has-popover<% end %>"
                    <% if is_manually_verified_incompatible %>tabindex="0"<% end %>>Not v2 compatible
                    <% if is_manually_verified_incompatible %>
                      <span class="popover-text">dbt has manually verified that this package version is not compatible with dbt v2</span>
                    <% end %>
                  </span>
                <% end %>
              </div>
              <em><%= package.versions[package.latest].description %></em>
            </div>
          </div>
        </div>
        
        <!-- Right column: Version selector -->
        <div class="package-version-selector">
          <div class="form-group">
            <label for="version-dropdown">Version</label>
            <div class="custom-version-dropdown" id="version-dropdown">
              <button type="button" class="custom-dropdown-toggle" aria-haspopup="listbox" aria-expanded="false">
                <span class="dropdown-selected-text">
                  <%= version.version %><% if version.version == package.latest %> (latest)<% end %>
                  <% if is_fully_compatible %>
                    <%= image_tag('fusion_atom.svg', {alt: 'v2 compatible', class: 'v2-icon'}) %>
                  <% elsif is_parse_compat %>
                    <%= image_tag('fusion_atom.svg', {alt: 'v2 parse compatible', class: 'v2-icon'}) %>
                  <% end %>
                </span>
                <span class="dropdown-arrow">▼</span>
              </button>
              <ul class="custom-dropdown-menu" role="listbox">
                <% for local_version, local_package_version in package.versions.sort_by { |key, _val| Gem::Version.new(key) }.reverse %>
                <li role="option" 
                    data-value="/<%= package.namespace %>/<%= package.name %>/<%= local_version %>"
                    <% if local_version == version.version %>class="selected"<% end %>>
                  <span class="option-text">
                    <%= local_version %><% if local_version == package.latest %> (latest)<% end %>
                  </span>
                  <% if is_v2_compatible(package, local_package_version) %>
                    <%= image_tag('fusion_atom.svg', {alt: 'v2 compatible', class: 'v2-icon'}) %>
                  <% elsif is_v2_parse_compatible(package, local_package_version) %>
                    <%= image_tag('fusion_atom.svg', {alt: 'v2 parse compatible', class: 'v2-icon'}) %>
                  <% end %>
                </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
        
      </div>

      <hr/>

      <div class="package-content-layout">
        <!-- Right column: v2 compatibility (HTML placed first to avoid <base> tag issues, CSS order:2) -->
        <div class="package-sidebar">
          <div class="v2-compatibility-section">
            <%
              v2c = v2_compat_data(version)
              is_manually_compatible = v2c && v2c.manually_verified_compatible == true
              is_manually_incompatible = v2c && v2c.manually_verified_incompatible == true
              is_manually_verified = is_manually_compatible || is_manually_incompatible
            %>

            <div class="v2c-header">
              <div class="v2c-header-icon">
                <%= image_tag('fusion_atom.svg', {alt: 'dbt v2', class: 'v2c-atom-icon'}) %>
              </div>
              <h3>v2 compatibility</h3>
            </div>

            <% if is_manually_verified %>
            <!-- Manually verified by dbt -->
            <div class="v2c-group">
              <div class="v2c-group-label">Manually verified by dbt</div>
              <div class="v2c-block">
                <div class="v2c-row">
                  <span class="v2c-label">Status</span>
                  <% if is_manually_compatible %>
                    <span class="v2c-status v2c-status--success">
                      <%= image_tag('status_success.svg', {alt: 'Compatible', class: 'v2c-status-icon'}) %>
                      Compatible
                    </span>
                  <% else %>
                    <span class="v2c-status v2c-status--error">
                      <%= image_tag('status_error.svg', {alt: 'Not compatible', class: 'v2c-status-icon'}) %>
                      Not compatible
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Collapsible details -->
            <details class="v2c-details">
              <summary class="v2c-details-summary">View compatibility details</summary>
              <div class="v2c-details-content">
                <div class="v2c-row">
                  <span class="v2c-label">require-dbt-version</span>
                  <% if !require_dbt_version_defined?(version) %>
                    <span class="v2c-status v2c-status--warning">
                      <%= image_tag('status_error.svg', {alt: 'Not defined', class: 'v2c-status-icon'}) %>
                      Not defined
                    </span>
                  <% elsif is_require_dbt_version_v2_compatible(version.require_dbt_version) %>
                    <span class="v2c-status v2c-status--success">
                      <%= image_tag('status_success.svg', {alt: 'Compatible', class: 'v2c-status-icon'}) %>
                      Compatible
                    </span>
                  <% else %>
                    <span class="v2c-status v2c-status--error">
                      <%= image_tag('status_error.svg', {alt: 'Not compatible', class: 'v2c-status-icon'}) %>
                      Not compatible
                    </span>
                  <% end %>
                </div>
                <div class="v2c-row">
                  <span class="v2c-label">Parse compatibility</span>
                  <% if v2c && !v2c.parse_compatible.nil? %>
                    <% if v2c.parse_compatible %>
                      <span class="v2c-status v2c-status--success">
                        <%= image_tag('status_success.svg', {alt: 'Passed', class: 'v2c-status-icon'}) %>
                        Passed
                      </span>
                    <% else %>
                      <span class="v2c-status v2c-status--error">
                        <%= image_tag('status_error.svg', {alt: 'Failed', class: 'v2c-status-icon'}) %>
                        Failed
                      </span>
                    <% end %>
                  <% else %>
                    <span class="v2c-status v2c-status--warning">
                      <%= image_tag('status_error.svg', {alt: 'Not yet tested', class: 'v2c-status-icon'}) %>
                      Not yet tested
                    </span>
                  <% end %>
                </div>
                <% if v2c && v2c.parse_compatibility_result && v2c.parse_compatibility_result.fusion_version %>
                <div class="v2c-row">
                  <span class="v2c-label">Tested with dbt v2</span>
                  <code class="v2c-code"><%= v2c.parse_compatibility_result.fusion_version %></code>
                </div>
                <% end %>
              </div>
            </details>
            <% else %>
            <!-- Set by package maintainer -->
            <div class="v2c-group">
              <div class="v2c-group-label">Set by package maintainer</div>
              <div class="v2c-block">
                <div class="v2c-row">
                  <span class="v2c-label">Package version</span>
                  <code class="v2c-code"><%= version.version %><% if version.version == package.latest %> (latest)<% end %></code>
                </div>
                <div class="v2c-row">
                  <span class="v2c-label">require-dbt-version</span>
                  <% if !require_dbt_version_defined?(version) %>
                    <span class="v2c-status v2c-status--warning">
                      <%= image_tag('status_error.svg', {alt: 'Not defined', class: 'v2c-status-icon'}) %>
                      Not defined
                    </span>
                  <% elsif is_require_dbt_version_v2_compatible(version.require_dbt_version) %>
                    <span class="v2c-status v2c-status--success">
                      <%= image_tag('status_success.svg', {alt: 'Compatible', class: 'v2c-status-icon'}) %>
                      Compatible
                    </span>
                  <% else %>
                    <span class="v2c-status v2c-status--error">
                      <%= image_tag('status_error.svg', {alt: 'Not compatible', class: 'v2c-status-icon'}) %>
                      Not compatible
                    </span>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Automated tests -->
            <div class="v2c-group">
              <div class="v2c-group-label">Automated tests</div>
              <div class="v2c-block">
                <div class="v2c-row">
                  <span class="v2c-label">Parse compatibility</span>
                  <% if v2c && !v2c.parse_compatible.nil? %>
                    <% if v2c.parse_compatible %>
                      <span class="v2c-status v2c-status--success">
                        <%= image_tag('status_success.svg', {alt: 'Passed', class: 'v2c-status-icon'}) %>
                        Passed
                      </span>
                    <% else %>
                      <span class="v2c-status v2c-status--error">
                        <%= image_tag('status_error.svg', {alt: 'Failed', class: 'v2c-status-icon'}) %>
                        Failed
                      </span>
                    <% end %>
                  <% else %>
                    <span class="v2c-status v2c-status--warning">
                      <%= image_tag('status_error.svg', {alt: 'Not yet tested', class: 'v2c-status-icon'}) %>
                      Not yet tested
                    </span>
                  <% end %>
                </div>
                <% if v2c && v2c.parse_compatibility_result && v2c.parse_compatibility_result.fusion_version %>
                <div class="v2c-row">
                  <span class="v2c-label">Tested with dbt v2</span>
                  <code class="v2c-code"><%= v2c.parse_compatibility_result.fusion_version %></code>
                </div>
                <div class="v2c-row v2c-row--link">
                  <a href="https://github.com/dbt-labs/hub.getdbt.com/blob/master/data/packages/<%= package.namespace %>/<%= package.name %>/versions/<%= version.id.split('/').last %>.json" class="v2c-link" target="_blank">View full parse test results</a>
                </div>
                <% end %>
              </div>
              <% unless v2c && !v2c.parse_compatible.nil? %>
              <p class="v2c-note">
                dbt has not yet run parse compatibility tests on this package version. Compatibility is based on the <code>require-dbt-version</code> setting.
              </p>
              <% end %>
            </div>
            <% end %>

            <!-- Footer help text -->
            <p class="v2c-footer">
              If you are the package maintainer and see unexpected compatibility errors, check 
              <a href="https://docs.getdbt.com/guides/fusion-package-compat" class="v2c-link">compatibility documentation</a> 
              and raise a PR 
              <a href="https://github.com/dbt-labs/hub.getdbt.com/edit/master/data/packages/<%= package.namespace %>/<%= package.name %>/versions/<%= version.id.split('/').last %>.json" class="v2c-link" target="_blank">here</a>
            </p>
          </div>
        </div>

        <!-- Left column: Installation and README (CSS order:1) -->
        <div class="package-main-content">
          <div class="row">
            <div class="col-md-12">
              <h3>Installation</h3>
              
              dbt version required: <%=
              if version.require_dbt_version != nil && version.require_dbt_version.length() > 0
                then 
                  if version.require_dbt_version.kind_of?(Array)
                    "<code>" + version.require_dbt_version.join(', ') + "</code>"
                  else
                    "<code>" + version.require_dbt_version + "</code>"
                  end
                else
                  "Not defined" 
                end
            %>

              <p>Include the following in your <code>packages.yml</code> file:
              <pre id='install'>
packages:
  - package: <%= package.namespace %>/<%= package.name %>
    version: <%= version.version %></pre>
              <p> Run <code>dbt deps</code> to install the package.
              <p> For more information on using packages in your dbt project, check out the <a href="https://docs.getdbt.com/docs/package-management">dbt Documentation</a>.
              <p><strong>Important Notice:</strong> dbt Labs does not certify or confirm the integrity, operability, effectiveness, or security of any Packages. Please read the <a href="<%= site_url %>/disclaimer">dbt Labs Package Disclaimer</a></p>
            </div>
          </div>

          <div class="row readme-row">
            <div class="col-md-12">
              <h3>README</h3>
              (<a href="<%= version._source.url %>">View on GitHub</a>)
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-md-12">
              <base href="<%= package.versions[package.latest]._source.url %>"
                    target="_blank">
              <article id="readme" class='markdown-body'>
                <div class="loading">
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</main>

<script>
  fetch('https://api.github.com/emojis')
    .then(function(r) { return r.json(); })
    .catch(function() { return {}; })
    .then(function(emojis) {
      if (Object.keys(emojis).length > 0) {
        function emojiChar(url) {
          var m = url.match(/\/unicode\/([0-9a-f-]+)\.png/i);
          if (!m) return null;
          try {
            return String.fromCodePoint.apply(String, m[1].split('-').map(function(h) { return parseInt(h, 16); }));
          } catch(e) { return null; }
        }

        marked.use({
          extensions: [{
            name: 'emoji',
            level: 'inline',
            start: function(src) { return src.indexOf(':'); },
            tokenizer: function(src) {
              var match = src.match(/^:([a-zA-Z0-9_+\-]+):/);
              if (match && emojis[match[1]]) {
                return { type: 'emoji', raw: match[0], name: match[1], url: emojis[match[1]] };
              }
            },
            renderer: function(token) {
              var ch = emojiChar(token.url);
              if (ch) return '<span class="emoji" aria-label=":' + token.name + ':">' + ch + '</span>';
              if (!/^https:\/\/github\.githubassets\.com\//.test(token.url)) return ':' + token.name + ':';
              return '<img class="emoji" src="' + token.url + '" alt=":' + token.name + ':" width="20" height="20" />';
            }
          }]
        });
      }
      $.get('<%= version._source.readme %>').done(function(data) {
        document.getElementById('readme').innerHTML = DOMPurify.sanitize(marked.parse(data));
      });
    });
  $('#install').each(function(i, block) {
    hljs.highlightBlock(block);
  });

  // Custom version dropdown behavior
  (function() {
    var dropdown = document.getElementById('version-dropdown');
    if (!dropdown) return;
    
    var toggle = dropdown.querySelector('.custom-dropdown-toggle');
    var menu = dropdown.querySelector('.custom-dropdown-menu');
    var options = Array.from(dropdown.querySelectorAll('li[role="option"]'));
    var focusIdx = options.findIndex(o => o.classList.contains('selected'));
    
    function close() { menu.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }
    
    function setFocus(idx) {
      options.forEach(o => o.classList.remove('focused'));
      focusIdx = (idx + options.length) % options.length;
      options[focusIdx].classList.add('focused');
      options[focusIdx].scrollIntoView({ block: 'nearest' });
    }
    
    function go(el) {
      var url = el.getAttribute('data-value');
      if (url && /^\/[\w.\/-]+$/.test(url)) window.location.href = window.location.origin + url;
    }
    
    toggle.addEventListener('click', e => {
      e.stopPropagation();
      var opening = !menu.classList.contains('open');
      menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', opening);
      if (opening) setFocus(Math.max(0, focusIdx));
    });
    
    options.forEach(o => o.addEventListener('click', () => go(o)));
    document.addEventListener('click', e => { if (!dropdown.contains(e.target)) close(); });
    
    toggle.addEventListener('keydown', e => {
      var isOpen = menu.classList.contains('open');
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen) { menu.classList.add('open'); toggle.setAttribute('aria-expanded', 'true'); }
        setFocus(focusIdx + (e.key === 'ArrowDown' ? 1 : -1));
      } else if (e.key === 'Enter' && isOpen) {
        e.preventDefault();
        go(options[focusIdx]);
      } else if (e.key === 'Escape') close();
    });
  })();
</script>
